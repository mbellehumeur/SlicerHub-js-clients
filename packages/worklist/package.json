{
  "name": "@slicer-hub/worklist",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "esbuild worklist.ts --bundle --format=esm --outfile=worklist.js && esbuild about-page.ts --bundle --format=esm --outfile=about.js",
    "build:watch": "esbuild worklist.ts --bundle --format=esm --outfile=worklist.js --watch",
    "build:worklist-catalog": "python tools/build_segroulette_worklist.py",
    "serve": "python -m http.server 8140",
    "serve:watch": "concurrently -n build,serve -c blue,green \"npm run build:watch\" \"npm run serve\""
  },
  "dependencies": {
    "@slicer-hub/client": "*",
    "i18next": "^26.4.2",
    "@slicer-hub/i18n": "*",
    "@slicer-hub/context-identity": "*"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "esbuild": "^0.21.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mbellehumeur/SlicerHub-js-clients.git",
    "directory": "packages/worklist"
  }
}
